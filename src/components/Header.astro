---
const base = import.meta.env.BASE_URL;
const home = base.endsWith('/') ? base : `${base}/`;
---

<header class="site-header">
  <a class="brand" href={home} aria-label="GrowthForge Digital home">
    <span class="brand-mark">G</span>
    <span>GrowthForge<span class="brand-dot">.</span></span>
  </a>

  <nav aria-label="Primary navigation">
    <a href={`${home}#services`}>Services</a>
    <a href={`${home}#solutions`}>Solutions</a>
    <a href={`${home}#work`}>Work</a>
    <a href={`${home}#tools`}>Tools</a>
    <a href={`${home}#about`}>About</a>
  </nav>

  <a class="header-cta" href={`${home}#contact`}>
    Free Audit <span>↗</span>
  </a>
</header>