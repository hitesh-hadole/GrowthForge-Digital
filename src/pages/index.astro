---
const email = "hiteshhadole@gmail.com";
// Replace this with your real website URL before publishing.
const siteUrl = "https://hitesh-hadole.github.io/GrowthForge-Digital/";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

const title = "GrowthForge Digital | SEO & Performance Marketing Freelancer";
const description = "GrowthForge Digital helps businesses grow through SEO, Google Ads, Meta Ads, conversion optimization and GA4 analytics. Freelance performance marketing focused on measurable growth.";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={description} />
<meta name="google-site-verification" content="ousZySD3NchUCIw8oneOV2nfhXNW1_xvwcHAe3SIMqs" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="author" content="GrowthForge Digital" />
<meta name="theme-color" content="#0B1220" />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<title>{title}</title>

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="GrowthForge Digital" />

<!-- X / Twitter -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#business`,
      "name": "GrowthForge Digital",
      "url": siteUrl,
      "description": description,
      "email": email,
      "serviceType": [
        "SEO",
        "Google Ads",
        "Meta Ads",
        "Conversion Rate Optimization",
        "Google Analytics 4",
        "Google Tag Manager"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "GrowthForge Digital",
      "description": description,
      "publisher": { "@id": `${siteUrl}/#business` }
    }
  ]
})} />

<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
 j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-N9JQF2GN');</script>
<!-- End Google Tag Manager -->
</head>
<body>
