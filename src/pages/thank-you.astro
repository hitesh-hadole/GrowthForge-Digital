---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main>
    <section class="thank-you">
      <div class="section-kicker">ENQUIRY RECEIVED</div>
      <h1>Thanks for reaching out.</h1>
      <p>Your growth enquiry has been received. I’ll review the details and get back to you shortly.</p>
      <a class="button primary" href="/">Back to GrowthForge <span>↗</span></a>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
.thank-you{min-height:70vh;padding:150px 5vw;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center}
.thank-you h1{font-family:'Space Grotesk';font-size:clamp(48px,6vw,80px);line-height:.95;letter-spacing:-.06em;margin:20px 0}
.thank-you p{max-width:560px;color:#667085;font-size:16px;margin:0 0 30px}
.thank-you .section-kicker{color:#7da82f}
</style>
